{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sttailor-atelier",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-19",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "sttailor.com",
      "custom_domain": true
    }
  ],
  "workers_dev": false,
  "preview_urls": false
}
