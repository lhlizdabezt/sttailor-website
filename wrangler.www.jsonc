{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sttailor-www-redirect",
  "main": "src/www-redirect.js",
  "compatibility_date": "2026-09-19",
  "routes": [
    {
      "pattern": "www.sttailor.com/*",
      "zone_name": "sttailor.com"
    }
  ],
  "workers_dev": false,
  "preview_urls": false
}
