{
  "name": "sttailor-cloudflare-worker",
  "private": true,
  "version": "1.1.0",
  "description": "Static-first S.T Tailor website for Cloudflare Workers",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs && node --test scripts/check-cloudflare-audit.mjs",
    "verify:live": "node scripts/verify-live.mjs",
    "notify:indexnow": "node scripts/submit-indexnow.mjs",
    "dev": "npm run build && wrangler dev",
    "deploy": "gh workflow run deploy.yml --ref main"
  },
  "devDependencies": {
    "lightningcss": "1.33.0",
    "wrangler": "4.147.0"
  }
}
